{
  "name": "luke",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:tui": "turbo -F tui dev",
    "native:android": "./scripts/native.sh android",
    "native:build": "./scripts/native.sh build all",
    "native:build:android": "./scripts/native.sh build android",
    "native:build:ios": "./scripts/native.sh build ios",
    "native:check": "./scripts/native.sh check",
    "native:doctor": "./scripts/native.sh doctor",
    "native:ios": "./scripts/native.sh ios",
    "native:prebuild": "./scripts/native.sh prebuild",
    "native:submit": "./scripts/native.sh submit all",
    "native:submit:android": "./scripts/native.sh submit android",
    "native:submit:ios": "./scripts/native.sh submit ios",
    "db:push": "turbo -F @luke/db db:push",
    "db:studio": "turbo -F @luke/db db:studio",
    "db:generate": "turbo -F @luke/db db:generate",
    "db:migrate": "turbo -F @luke/db db:migrate",
    "db:seed": "turbo -F @luke/db db:seed",
    "db:start": "turbo -F @luke/db db:start",
    "db:watch": "turbo -F @luke/db db:watch",
    "db:stop": "turbo -F @luke/db db:stop",
    "db:down": "turbo -F @luke/db db:down",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@luke/env": "*",
    "dotenv": "^17.2.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@luke/config": "*",
    "@types/node": "^22.13.14",
    "husky": "latest",
    "lefthook": "latest",
    "turbo": "^2.9.16",
    "typescript": "^6",
    "ultracite": "7.7.0"
  },
  "packageManager": "npm@10.9.7"
}
